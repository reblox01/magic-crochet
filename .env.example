# Supabase
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Site
VITE_SITE_URL=https://your-domain.com

# Preloader
VITE_ENABLE_PRELOADER=true

# Resend (email - Phase 7)
RESEND_API_KEY=your_resend_api_key_here

# AI Providers (fallback chain: OpenCode Zen → Google → OpenRouter)
OPENCODE_ZEN_API_KEY=your_opencode_zen_api_key_here
GOOGLE_AI_STUDIO_API_KEY=your_google_ai_studio_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
